# OpenCode server
# Required for preflight / server auth:
OPENCODE_SERVER_PASSWORD=change-me
OPENCODE_SERVER_USERNAME=opencode
CONFIG_REPO=https://github.com/roborew/opencode-config.git
CONFIG_REF=develop

# Runtime UID/GID for bind-mount parity (host file ownership). setup/preflight
# auto-fills these from the logged-in user (`id -u` / `id -g`). Leave blank to
# let setup write them, or set OPENCODE_USERNAME to resolve a named host account.
# Explicit numeric values always win.
# OPENCODE_USERNAME=robo
# OPENCODE_UID=
# OPENCODE_GID=

# Host port publishing (compose defaults after :- if unset)
# Host publish port (must match container listen port; avoid 4096 — Kilo uses it)
OPENCODE_PUBLISH_PORT=4097
# Hard ceiling for opencode-server. The default limits OpenCode to 8 GiB and
# disables container swap so an unbounded process cannot exhaust the host.
# Raise only after investigating sustained memory usage.
OPENCODE_MEMORY_LIMIT=8g
OPENCODE_MEMORY_SWAP_LIMIT=8g
MILVUS_PUBLISH_PORT=19530
MILVUS_HEALTH_PUBLISH_PORT=9091
MINIO_API_PUBLISH_PORT=19000
MINIO_CONSOLE_PUBLISH_PORT=19001

# Twingate — store in Infisical (not required on host when using ./scripts/compose.sh).
# Local fallback only if you run bare `docker compose` without Infisical injection.
# TWINGATE_NETWORK=
# TWINGATE_ACCESS_TOKEN=
# TWINGATE_REFRESH_TOKEN=

# OpenCode / providers (local fallback; deployed via Infisical)
# OPENROUTER_API_KEY — model provider (preflight warns if missing)
OPENROUTER_API_KEY=
# GH_ORG + GH_TOKEN — required for ./scripts/setup.sh projects github
# Prefer a fine-grained PAT (github_pat_*). See docs/integrations.md for
# repository + organization permissions. Classic alternative: repo + read:org.
GH_ORG=
GH_PROJECT=
GH_TOKEN=
# Branch to checkout after github clone/update (default: develop).
# OPENCODE_WORK_BRANCH=develop

# Git identity for commits made by OpenCode inside the container.
# Sets git config user.* and GIT_AUTHOR_* / GIT_COMMITTER_* (so agent commits
# attribute to you, not opencode@local). Prefer your GitHub-verified email or
# the noreply form: 12345678+username@users.noreply.github.com
GIT_USER_NAME=
GIT_USER_EMAIL=
# Optional overrides (default to GIT_USER_* when unset):
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
# GIT_COMMITTER_NAME=
# GIT_COMMITTER_EMAIL=

# CodeRabbit CLI (agent code review in container)
# Agentic API key from CodeRabbit dashboard → API Keys (requires Usage-based Add-on)
CODERABBIT_API_KEY=

# claude-context / Milvus
# OPENAI_API_KEY — embeddings for claude-context MCP (preflight warns if missing)
# Compose profile: keep "milvus" enabled for indexing; clear COMPOSE_PROFILES to
# skip etcd/minio/milvus and free RAM when you only need the OpenCode server.
COMPOSE_PROFILES=milvus
MILVUS_TOKEN=local
OPENAI_API_KEY=
EMBEDDING_PROVIDER=OpenAI

# Loopback URL rewrite inside the container (webfetch, curl in bash, etc.)
# localhost / 127.0.0.1 / [::1] → DOCKER_HOST_INTERNAL before tools run
DOCKER_HOST_INTERNAL=host.docker.internal
LOCALHOST_REWRITE=1

# Infisical runtime injection (set in deployed environments;
# leave blank locally to use .env values directly)
INFISICAL_PROJECT_ID=
INFISICAL_ENV=dev
INFISICAL_DOMAIN=https://eu.infisical.com
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_TOKEN=
INFISICAL_USE_CLI=true

# Optional paths — prefer Infisical (./scripts/compose.sh). Leave blank on host
# so Infisical supplies OPENCODE_APPS_DIR / OPENCODE_WORKTREES_DIR. Set here only
# to override Infisical on this machine.
# Host directory of git repos — same-path bind into the container (absolute path;
# Docker does not expand ~). OpenCode registers projects at this path so git/Tower
# worktree links use local paths.
# Examples: /Users/you/projects  or  /data/opencode/apps
# OPENCODE_APPS_DIR=
# Skip these basename globs in per-repo .env checks (preflight + projects setup).
# Spec hubs (*-spec) usually need no sandbox Infisical .env. Default: *-spec
# Set empty to include every repo: OPENCODE_REPO_ENV_SKIP=
# Comma-separated globs: *-spec,*-docs
# OPENCODE_REPO_ENV_SKIP=*-spec
# Host path for OpenCode workspace worktrees (absolute; must end with /opencode/worktree).
# Same-path bind; XDG is aligned so OpenCode creates worktrees here (Desktop default:
# ~/.local/share/opencode/worktree). Chats/sessions stay on the opencode-data volume.
# Examples: /Users/you/.local/share/opencode/worktree
# OPENCODE_WORKTREES_DIR=
# Desktop workspace create/delete (required; compose defaults to true). Without this,
# POST /experimental/workspace times out waiting for workspace.status.
OPENCODE_EXPERIMENTAL_WORKSPACES=true
DOCKER_VOLUME_DIRECTORY=../milvus

# Canonical hostname for Twingate clients (setup can map this to ********* on the host)
OPENCODE_FQDN=opencode.home.internal
# Post-compose setup: ./scripts/setup.sh
#   preflight + project sync + /etc/hosts
# Does not configure or modify OpenCode.app.
# Managed MCP authentication is configured in MCPJungle, not this container.

# -----------------------------------------------------------------------------
# Optional Sysbox sibling sandboxes (Ubuntu only — Mac leave off)
# -----------------------------------------------------------------------------
# These are runtime config — prefer Infisical (./scripts/compose.sh). Set here
# only to override Infisical on this machine. OpenCode container reads them via
# the `env_file` / `environment:` block; the in-container `sandbox` CLI also
# reads them. Setup writes OPENCODE_SANDBOX_ENABLED and COMPOSE_FILE based on
# OPENCODE_SANDBOX_MODE — do not hand-edit unless you know you need to force
# 0/1 on the running stack.
#
# OPENCODE_SANDBOX_MODE — off (default) | auto | on
#   off  = Mac-safe stack. No docker.sock, no sibling sandboxes.
#   auto = setup probes for sysbox-runc; enables overlay if present, else stays off.
#   on   = require Sysbox; setup fails if missing.
OPENCODE_SANDBOX_MODE=off
# OPENCODE_SANDBOX_ENABLED — 0|1. Written by setup based on MODE; leave blank.
# OPENCODE_SANDBOX_IMAGE — sibling image (build: ./scripts/sandbox/build-image.sh).
# OPENCODE_SANDBOX_RUNTIME — default sysbox-runc.
# OPENCODE_SANDBOX_REVIEW_DNS — on|off; agent DNS upsert gate (default on).
# OPENCODE_SANDBOX_ROUTE_IMAGE — publish helper image (default alpine/socat:*******).
# OPENCODE_SANDBOX_TUNNEL_ID — existing host tunnel UUID (hint for agents).
# When enabled, setup sets COMPOSE_FILE=docker-compose.yml:docker-compose.sandbox.yml.
# That overlay mounts /var/run/docker.sock into OpenCode for sibling control only.
