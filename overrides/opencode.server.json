{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": {
      "/workspace/**": "allow",
      "/var/opencode-xdg/opencode/worktree/**": "allow"
    }
  },
  "experimental": {
    "todo": true
  },
  "mcp": {
    "augment-context-engine": {
      "enabled": false,
      "disabled": true
    },
    "auggie": {
      "enabled": false,
      "disabled": true
    },
    "claude-context": {
      "type": "local",
      "enabled": true,
      "command": [
        "claude-context-mcp"
      ],
      "timeout": 120000,
      "environment": {
        "OPENAI_API_KEY": "{env:OPENAI_API_KEY}",
        "MILVUS_ADDRESS": "{env:MILVUS_ADDRESS}",
        "MILVUS_TOKEN": "{env:MILVUS_TOKEN}",
        "EMBEDDING_PROVIDER": "{env:EMBEDDING_PROVIDER}"
      }
    }
  }
}
