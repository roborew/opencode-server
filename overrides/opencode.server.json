{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "external_directory", "resource": "/var/opencode-xdg/opencode/worktree/*", "effect": "allow" }
  ],
  "experimental": {
    "todo": true
  },
  "worktree": {
    "directory": "{env:OPENCODE_WORKTREES_DIR}"
  },
  "mcp": {
    "servers": {
      "browse": {
        "disabled": true
      }
    }
  },
  "plugins": [
    { "package": "./plugins/localhost-to-docker-host.js" },
    { "package": "./plugins/rewrite-worktree-gitdirs.js" }
  ]
}
