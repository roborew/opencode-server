{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": {
      "/workspace/**": "allow",
      "/var/opencode-xdg/opencode/worktree/**": "allow"
    }
  },
  "experimental": {
    "todo": true
  },
  "worktree": {
    "directory": "{env:OPENCODE_WORKTREES_DIR}"
  },
  "mcp": {
    "servers": {
      "claude-context": {
        "type": "local",
        "command": ["claude-context-mcp"],
        "timeout": { "execution": 120000 },
        "environment": {
          "OPENAI_API_KEY": "{env:OPENAI_API_KEY}",
          "MILVUS_ADDRESS": "{env:MILVUS_ADDRESS}",
          "MILVUS_TOKEN": "{env:MILVUS_TOKEN}",
          "EMBEDDING_PROVIDER": "{env:EMBEDDING_PROVIDER}"
        }
      },
      "browse": {
        "disabled": true
      }
    }
  },
  "plugins": [
    { "package": "./plugins/localhost-to-docker-host.js" },
    { "package": "./plugins/rewrite-worktree-gitdirs.js" }
  ]
}
